{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/sync.py\" --hook || python \"${CLAUDE_PLUGIN_ROOT}/scripts/sync.py\" --hook || py \"${CLAUDE_PLUGIN_ROOT}/scripts/sync.py\" --hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
